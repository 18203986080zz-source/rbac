<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.rudecrab.rbac.mapper.EmployeeMapper">
    <!--分页查询员工，关联公司表取公司名称-->
    <select id="selectPage" resultType="com.rudecrab.rbac.model.vo.EmployeePageVO">
        SELECT
            e.id,
            e.name,
            e.phone,
            e.email,
            e.age,
            e.salary,
            e.company_id,
            c.name AS company_name,
            e.create_time
        FROM
            employee e
            LEFT JOIN company c ON e.company_id = c.id
        ${ew.customSqlSegment}
    </select>
</mapper>
